# Local npm/Docker Compose configuration only. Kubernetes does not read this file.
COMPOSE_PROJECT_NAME=fiware

# Docker Compose service versions and local ports
ORION_PORT=1026
ORION_VERSION=4.1.0
MONGO_DB_PORT=27017
MONGO_DB_VERSION=6.0

# Lepus settings
DEBUG=adapter:*
NGSI_V2_CONTEXT_BROKER=
NGSI_V2_TIMEOUT=10000
LEPUS_DEFAULT_TENANT=
AUTH_URL=
AUTH_USER=
AUTH_PASSWORD=
